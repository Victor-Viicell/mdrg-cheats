WINDOW = 28  # bytes after a call in which callers test the return value
FN_WINDOW = 0x400  # bytes scanned when walking a whole function body


# --------------------------------------------------------------------------- ELF
class Elf:
    """Minimal ELF64 reader: vaddr <-> file offset via PT_LOAD headers."""

    def __init__(self, path: Path):
        self.path = path
        self.data = path.read_bytes()
        if self.data[:4] != b"\x7fELF":
            raise SystemExit(f"{path} is not an ELF file")
        if self.data[4] != 2:
            raise SystemExit("only 64-bit ELF is supported")
        if struct.unpack_from("<H", self.data, 0x12)[0] != 0x3E:
            raise SystemExit("not an x86-64 binary")
        self.pt_load: list[tuple[int, int, int, int]] = []
        phoff = struct.unpack_from("<Q", self.data, 0x20)[0]
        phentsize = struct.unpack_from("<H", self.data, 0x36)[0]
        phnum = struct.unpack_from("<H", self.data, 0x38)[0]
        for i in range(phnum):
            off = phoff + i * phentsize
            if struct.unpack_from("<I", self.data, off)[0] != 1:
                continue
            self.pt_load.append(
                (
                    struct.unpack_from("<Q", self.data, off + 16)[0],  # p_vaddr
                    struct.unpack_from("<Q", self.data, off + 8)[0],   # p_offset
                    struct.unpack_from("<Q", self.data, off + 32)[0],  # p_filesz
                    struct.unpack_from("<I", self.data, off + 4)[0],   # p_flags
                )
            )
        self._writes: dict[int, bytes] = {}

    def v2o(self, vaddr: int) -> int | None:
        for vaddr0, off0, size, _f in self.pt_load:
            if vaddr0 <= vaddr < vaddr0 + size:
                return off0 + vaddr - vaddr0
        return None

    def o2v(self, off: int) -> int | None:
        for vaddr0, off0, size, _f in self.pt_load:
            if off0 <= off < off0 + size:
                return vaddr0 + off - off0
        return None

    def at(self, vaddr: int, n: int) -> bytes:
        off = self.v2o(vaddr)
        return b"" if off is None else self.data[off:off + n]

    def write(self, vaddr: int, payload: bytes) -> None:
        off = self.v2o(vaddr)
        if off is None:
            raise SystemExit(f"cannot map vaddr {vaddr:#x} to a file offset")
        self._writes[off] = payload

    def render(self) -> bytes:
        out = bytearray(self.data)
        for off, payload in self._writes.items():
            out[off:off + len(payload)] = payload
        return bytes(out)

    def exec_segments(self):
        for vaddr0, off0, size, flags in self.pt_load:
            if flags & 1:
                yield vaddr0, self.data[off0:off0 + size]


# ------------------------------------------------------------------- call graph
def cmp_reg_imm(chunk: bytes, j: int):
    """Decode `cmp reg, imm` at j -> (imm, length) or None."""
    b, m = chunk[j], chunk[j + 1]
    if b == 0x83 and (m & 0xF8) == 0xF8:          # cmp r32, imm8
        return chunk[j + 2], 3
    if b == 0x81 and (m & 0xF8) == 0xF8:          # cmp r32, imm32
        return struct.unpack_from("<I", chunk, j + 2)[0], 6
    if b == 0x3D:                                  # cmp eax, imm32
        return struct.unpack_from("<I", chunk, j + 1)[0], 5
    return None


def build_call_index(elf: Elf):
    """One pass over the code: target -> {'sete': [(site, imm, len)], 'setg': [(site, len)], 'cmp': [imm]}.

    `sete`/`setg` require the boolean-wrapper shape to sit *immediately* after the call
    (that is the strong signal that pins GetCheatTier). `cmp` harvests every immediate
    the callers test the return value against, anywhere in the following window.
    """
    index: dict[int, dict[str, list]] = {}
    for base, code in elf.exec_segments():
        n = len(code)
        for i in range(n - 5):
            if code[i] != 0xE8:
                continue
            rel = struct.unpack_from("<i", code, i + 1)[0]
            target = base + i + 5 + rel
            site = base + i
            chunk = code[i + 5:i + 5 + WINDOW]
            entry = index.setdefault(target, {"sete": [], "setg": [], "cmp": []})

            # --- strict wrapper shapes, straight after the call ---
            decoded = cmp_reg_imm(chunk, 0)
            if decoded and chunk[decoded[1]:decoded[1] + 3] == b"\x0f\x94\xc0":      # cmp; sete al
                entry["sete"].append((site, decoded[0], 5 + decoded[1] + 3))         # call + cmp + sete
            if chunk[0:2] == b"\x85\xc0" and chunk[2:5] == b"\x0f\x9f\xc0":           # test eax,eax; setg al
                entry["setg"].append((site, 5 + 2 + 3))
            elif chunk[0:3] == b"\x48\x85\xc0" and chunk[3:6] == b"\x0f\x9f\xc0":     # test rax,rax; setg al
                entry["setg"].append((site, 5 + 3 + 3))

            # --- tier values the callers compare against ---
            for j in range(len(chunk) - 8):
                other = cmp_reg_imm(chunk, j)
                if other and 0 < other[0] < 0x10000:
                    entry["cmp"].append((site, other[0]))
    return index


def body_cmp_constants(elf: Elf, fn: int, window: int = 0x400) -> list[int]:
    """Fallback tier values: what the function itself compares against."""
    body = elf.at(fn, window)
    values = set()
    for j in range(len(body) - 8):
        decoded = cmp_reg_imm(body, j)
        if decoded and 0 < decoded[0] < 0x10000:
            values.add(decoded[0])
    return sorted(values)


def build_site_index(elf: Elf) -> dict[int, list[int]]:
    """Reverse call map: callee vaddr -> every direct `call` site."""
    sites: dict[int, list[int]] = {}
    for base, code in elf.exec_segments():
        for i in range(len(code) - 5):
            if code[i] != 0xE8:
                continue
            rel = struct.unpack_from("<i", code, i + 1)[0]
            sites.setdefault(base + i + 5 + rel, []).append(base + i)
    return sites


def dense_clusters(sites: list[int], gap: int = 0x200) -> list[list[int]]:
    """Group call sites so that consecutive sites are at most `gap` apart."""
    out: list[list[int]] = []
    for site in sorted(sites):
        if out and site - out[-1][-1] <= gap:
            out[-1].append(site)
        else:
            out.append([site])
    return out


def find_validator(sites: dict[int, list[int]], gate: dict) -> int | None:
    """The cheat-code checker.

    Signature: called once by GetCheatTier and three times in a row by the
    in-game "enter cheat code" path - and nothing else calls it.
    """
    tier_fn = gate["tier_fn"]

    def inside_tier(site: int) -> bool:
        return tier_fn <= site < tier_fn + FN_WINDOW

    best = None
    for target, callers in sites.items():
        if not 4 <= len(callers) <= 24:
            continue
        if not any(inside_tier(s) for s in callers):
            continue
        clusters = [c for c in dense_clusters(callers) if len(c) >= 3]
        if not clusters:
            continue
        distance = min(abs(c[-1] - tier_fn) for c in clusters)
        if best is None or distance < best[0]:
            best = (distance, target)
    return best[1] if best else None


def forward_jumps(elf: Elf, start: int, window: int) -> list[tuple[int, int]]:
    """6-byte conditional jumps (jcc rel32) that jump forward inside the window."""
    body = elf.at(start, window)
    hits = []
    for j in range(len(body) - 6):
        if body[j] == 0x0F and 0x80 <= body[j + 1] <= 0x8F:
            rel = struct.unpack_from("<i", body, j + 2)[0]
            target = start + j + 6 + rel
            if start + j < target < start + window + 0x1000:
                hits.append((start + j, target))
    return hits


def find_code_gate(elf: Elf, gate: dict, sites: dict[int, list[int]], validator: int) -> dict | None:
    """The in-game "enter cheat code" path: the *other* caller of the code
    checker. It runs the entered code through the checker last and rejects the
    key when the checker does not recognise it - that single verdict branch is
    what we disable, so any key the player types is accepted."""
    callers = sites.get(validator, [])
    outside = [s for s in callers if not gate["tier_fn"] <= s < gate["tier_fn"] + FN_WINDOW]
    if not outside:
        return None

    # the last dense cluster is the state machine's three calls in a row
    # (your code + two embedded self-test codes)
    cluster = dense_clusters(outside)[-1]
    last_call = cluster[-1]

    hits = forward_jumps(elf, last_call + 5, 0x200)
    if len(hits) < 2:
        return None
    counts: dict[int, int] = {}
    for _site, target in hits:
        counts[target] = counts.get(target, 0) + 1
    reject, times = max(counts.items(), key=lambda kv: kv[1])
    if times < 2:
        return None

    guards = [site for site, target in hits if target == reject]
    dense = [guards[0]]
    for site in guards[1:]:
        if site - dense[-1] <= 0x40:
            dense.append(site)
        else:
            break
    verdict = dense[-1]          # the branch testing the *entered* key itself
    accept = verdict + 6
    tail = elf.at(accept, 0x80)
    if not tail or tail[0] == 0x0F or b"\xe8" not in tail:
        return None
    return {
        "validator": validator,
        "call_sites": cluster,
        "guards": dense,          # every reject branch, for reporting
        "verdict": verdict,       # the key verdict we neutralise
        "reject": reject,
        "accept": accept,
    }


# ------------------------------------------------------------------- gate finding
def find_gate_fresh(elf: Elf, index) -> dict | None:
    """Locate an *unpatched* gate: the callee shared by both boolean-wrapper shapes."""
    candidates = [t for t, e in index.items() if e["sete"] and e["setg"]]
    if not candidates:
        return None

    scored = []
    for target in candidates:
        entry = index[target]
        debug_values = sorted({imm for _s, imm, _l in entry["sete"] if 0 < imm < 0x10000})
        if not debug_values:
            continue
        debug_const = max(debug_values)

        # Which value do the callers actually gate on? The constant tested at the most
        # distinct call sites is the real tier value (junk immediates appear once).
        sites_per_value: dict[int, set] = {}
        for csite, value in entry["cmp"]:
            sites_per_value.setdefault(value, set()).add(csite)
        below = {v: len(s) for v, s in sites_per_value.items() if 0 < v < debug_const}
        body_cmps = body_cmp_constants(elf, target)

        if below:
            advanced = max(below.items(), key=lambda kv: (kv[1], kv[0]))[0]
            source = f"callers ({below[advanced]}/{len(entry['cmp'])} sites)"
        else:
            wanted = [v for v in body_cmps if v < debug_const] or body_cmps
            if not wanted:
                continue
            advanced, source = max(wanted), "body"
        if advanced <= 0 or advanced >= debug_const:
            continue

        score = 3 * len(below) + len(body_cmps) + len(entry["setg"])
        site, _imm, region = entry["sete"][0]
        any_site, any_len = entry["setg"][0]
        scored.append((score, target, {
            "tier_fn": target,
            "advanced": advanced,
            "debug_const": debug_const,
            "debug_site": site,
            "debug_len": region,
            "any_site": any_site,
            "any_len": any_len,
            "compared": sorted(sites_per_value),
            "body_cmps": body_cmps,
            "call_sites": len(entry["sete"]) + len(entry["setg"]),
            "source": source,
            "patched": False,
            "partially_patched": False,
        }))
    if not scored:
        return None
    scored.sort(key=lambda item: item[0], reverse=True)
    return scored[0][2]


def find_gate_patched(elf: Elf, index) -> dict | None:
    """Recover the gate from a library this script already patched.

    The wrapper tails are overwritten, but both the tier function entry
    (`mov eax,<v>; ret`) and the callers' comparisons survive.
    """
    for target, entry in index.items():
        head = elf.at(target, 6)
        if len(head) != 6 or head[0] != 0xB8 or head[5] != 0xC3:
            continue
        value = struct.unpack_from("<I", head, 1)[0]
        if not 0 < value < 0x10000:
            continue
        matching = sorted({csite for csite, value2 in entry["cmp"] if value2 == value})
        if len(matching) >= 2:  # the game's own callers still compare against it
            return {
                "tier_fn": target,
                "advanced": value,
                "debug_const": None,
                "debug_site": None,
                "debug_len": 0,
                "any_site": None,
                "any_len": 0,
                "compared": sorted({v for _s, v in entry["cmp"]}),
                "body_cmps": [],
                "call_sites": len(matching),
                "source": "recovered",
                "patched": True,
                "partially_patched": False,
            }
    return None


def analyse(elf: Elf) -> dict | None:
    """Structural analysis of the *pristine* code. Never looks at patch state."""
    index = build_call_index(elf)
    gate = find_gate_fresh(elf, index)
    if gate is None:
        return find_gate_patched(elf, index)

    # the cheat-key verdict lives in the coroutine that handles the in-game
    # "enter cheat code" button: it is the last caller of the key checker.
    sites = build_site_index(elf)
    validator = find_validator(sites, gate)
    gate["validator"] = validator
    gate["code_gate"] = find_code_gate(elf, gate, sites, validator) if validator else None
    gate["patched"] = False
    gate["partially_patched"] = False
    return gate


def patch_state(live: Elf, gate: dict) -> dict:
    """Which patches are present in the installed library, and is it complete?

    With the key gate patched the library must NOT carry the GetCheatTier pin:
    a pinned tier makes the game report "cheats enabled" no matter what is
    stored, which hides the key input in the cheats popup.
    """
    key_gate = gate.get("code_gate")
    key_ok = (
        live.at(key_gate["validator"], len(KEY_STUB)) == KEY_STUB
        and all(live.at(site, 6) == NOP6 for site in key_gate["guards"])
        if key_gate
        else None
    )
    tail_ok = (
        gate["debug_site"] is not None
        and live.at(gate["debug_site"], gate["debug_len"]) == patch_true(gate["debug_len"])
    )
    entry_ok = gate["debug_site"] is not None and any(
        live.at(gate["debug_site"] - back, 6) == b"\xb8\x01\x00\x00\x00\xc3"
        for back in range(0, 0xA0)
    )
    wrappers_ok = tail_ok or entry_ok
    tier_pinned = live.at(gate["tier_fn"], 6) == patch_mov_eax(gate["advanced"])
    stale_pin = bool(key_gate) and tier_pinned

    complete = (key_ok is not False) and wrappers_ok and not stale_pin
    return {
        "key": key_ok,
        "wrappers": wrappers_ok,
        "tier_pinned": tier_pinned,
        "stale_pin": stale_pin,
        "patched": complete,
        "partially_patched": not complete,
    }


# ------------------------------------------------------------------- patch bytes
NOP6 = b"\x90" * 6

# Entry stub for the cheat-key checker: "any key you type is a valid advanced
# key, an empty key means cheats off". 19 bytes; both paths return, so the
# original prologue it overwrites is never needed.
#   test rdi,rdi / je zero / cmp dword [rdi+0x10],0 / je zero / mov eax,20 / ret
#   zero: xor eax,eax / ret
KEY_STUB = bytes.fromhex("4885ff740c837f10007406b814000000c331c0c3")


def patch_mov_eax(value: int) -> bytes:
    return struct.pack("<BI", 0xB8, value) + b"\xc3"


def patch_true(region_len: int) -> bytes:
    return struct.pack("<BI", 0xB8, 1) + b"\x90" * (region_len - 5)


def apply_patch(elf: Elf, gate: dict, state: dict | None = None) -> list[str]:
    """Write the full patch set into `elf` (always called on pristine bytes)."""
    log = []

    def emit(label: str, addr: int, payload: bytes) -> None:
        off = elf.v2o(addr)
        log.append(f"{label}  vaddr {addr:#x}  file offset {off:#x}  <- {payload.hex(' ')}")
        elf.write(addr, payload)

    key_gate = gate.get("code_gate")
    if key_gate:
        # make the checker accept whatever key the player types, and drop the
        # reject branches so the enter-code path stores it
        emit(
            f"cheat-key check                 (any key is advanced={gate['advanced']})",
            key_gate["validator"],
            KEY_STUB,
        )
        for site in key_gate["guards"]:
            emit("cheat-key reject branch        (removed)", site, NOP6)
    else:
        # no key gate found: fall back to pinning the tier itself
        emit(
            f"GetCheatTier                   (returns advanced={gate['advanced']})",
            gate["tier_fn"],
            patch_mov_eax(gate["advanced"]),
        )

    emit("DebugEnabled wrapper tail     (forced true)", gate["debug_site"], patch_true(gate["debug_len"]))
    emit("AnyCheatsEnabled wrapper tail (forced true)", gate["any_site"], patch_true(gate["any_len"]))
    return log


# ------------------------------------------------------------------------- install
def looks_like_il2cpp_game(d: Path) -> bool:
    if not (d / "GameAssembly.so").is_file():
        return False
    for data in d.glob("*_Data"):
        if (data / "il2cpp_data/Metadata/global-metadata.dat").is_file():
            return True
    return False


def find_game_dir(explicit: str | None) -> Path:
    if explicit:
        d = Path(explicit).expanduser().resolve()
        if not looks_like_il2cpp_game(d):
            raise SystemExit(f"{d} does not look like a Unity IL2CPP game folder")
        return d
    candidates: list[Path] = []
    for root in SEARCH_ROOTS:
        if not root.is_dir():
            continue
        for entry in sorted(root.iterdir()):
            dirs = [entry] + ([p for p in entry.iterdir() if p.is_dir()] if entry.is_dir() else [])
            candidates += [d for d in dirs if looks_like_il2cpp_game(d)]
    if not candidates:
        raise SystemExit(
            "Could not find the game. Pass --game-dir /path/to/game (the folder with GameAssembly.so)."
        )
    hinted = [c for c in candidates if any(h in str(c).lower() for h in GAME_HINTS)]
    return (hinted or candidates)[0]


def game_version(game_dir: Path) -> str:
    receipt = game_dir / ".itch/receipt.json.gz"
    if receipt.is_file():
        try:
            with gzip.open(receipt) as fh:
                doc = json.load(fh)
            for build in ((doc.get("upload") or {}).get("build"), doc.get("build")):
                if isinstance(build, dict) and build.get("userVersion"):
                    return str(build["userVersion"])
        except Exception:
            pass
    for marker in ("version.txt", "VERSION"):
        f = game_dir / marker
        if f.is_file():
            return f.read_text(errors="replace").strip().splitlines()[0][:32]
    return "unknown"


def game_running(game_dir: Path) -> list[str]:
    hits = []
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit() or not (proc / "cmdline").is_file():
            continue
        try:
            cmd = (proc / "cmdline").read_bytes().replace(b"\x00", b" ").decode("utf-8", "replace")
        except OSError:
            continue
        if "mdrg-cheats" in cmd:
            continue
        if str(game_dir) in cmd and (".x86_64" in cmd or "Dystopian" in cmd):
            hits.append(f"pid {proc.name}: {cmd.strip()[:90]}")
    return hits


# ------------------------------------------------------- in-game cheat code marker
CHEAT_MARKER = "A~"                       # prefix every in-game cheat handler tests for
KEY_HINT = CHEAT_MARKER + "1234567890"    # what we tell the player to type (>=10 chars)


def unity_data_dir(game_dir: Path) -> Path | None:
    """~/.config/unity3d/<company>/<product>, read out of the game's app.info."""
    app_info = None
    for data in game_dir.glob("*_Data"):
        if (data / "app.info").is_file():
            app_info = data / "app.info"
            break
    if app_info is None:
        return None
    lines = [ln.strip() for ln in app_info.read_text(errors="replace").splitlines() if ln.strip()]
    if len(lines) < 2:
        return None
    cfg = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
    return cfg / "unity3d" / lines[0] / lines[1]


def prefs_store(game_dir: Path) -> Path | None:
    d = unity_data_dir(game_dir)
    return None if d is None else d / "Saves" / "PlayerPrefs.pp"


def prefs_key_value(path: Path, key: str) -> str | None:
    try:
        data = json.loads(path.read_text())
    except Exception:
        return None
    for entry in data.get("data", []):
        if entry.get("Key") == key:
            return entry.get("Value")
    return None


def set_prefs_key(path: Path, key: str, value: str) -> bool:
    """Set one key in the game's own PlayerPrefs store; True if the file changed."""
    data = json.loads(path.read_text()) if path.is_file() else {"data": []}
    entries = data.setdefault("data", [])
    for entry in entries:
        if entry.get("Key") == key:
            if entry.get("Value") == value:
                return False
            entry["Value"] = value
            break
    else:
        entries.append({"Key": key, "Value": value})
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, separators=(",", ":")))
    return True


def disasm(path: Path, vaddr: int, nbytes: int) -> str | None:
    if not which("objdump"):
        return None
    try:
        out = subprocess.run(
            ["objdump", "-d", f"--start-address={vaddr}", f"--stop-address={vaddr + nbytes}",
             "-M", "intel", str(path)],
            capture_output=True, text=True, timeout=180).stdout
    except Exception:
        return None
    lines = [ln for ln in out.splitlines() if ":\t" in ln]
    return "\n".join("    " + ln.split(":", 1)[1].strip() for ln in lines) or None


# ------------------------------------------------------------------------------ main
def main() -> int:
    ap = argparse.ArgumentParser(description="Enable cheats in any My Dystopian Robot Girlfriend version.")
    ap.add_argument("--game-dir", help="game folder containing GameAssembly.so")
    ap.add_argument("--status", action="store_true", help="report state, change nothing")
    ap.add_argument("--dry-run", action="store_true", help="show patches, change nothing")
    ap.add_argument("--revert", action="store_true", help="restore the pristine library")
    ap.add_argument("--clear-key", action="store_true", help="clear the stored cheat key so the game offers the key field")
    ap.add_argument("--force", action="store_true", help="proceed even if the game is running")
    args = ap.parse_args()

    game_dir = find_game_dir(args.game_dir)
    so_path = game_dir / "GameAssembly.so"
    version = game_version(game_dir)
    SHARE.mkdir(parents=True, exist_ok=True)
    backup = SHARE / f"GameAssembly.so.{version}.orig"
    prefs = prefs_store(game_dir)
    prefs_backup = SHARE / f"PlayerPrefs.pp.{version}.orig"

    print(f"game     : {game_dir}")
    print(f"version  : {version}")
    print(f"library  : {so_path}  ({so_path.stat().st_size:,} bytes, sha256 {sha256(so_path.read_bytes()).hexdigest()[:16]})")
    print(f"backups  : {SHARE}")

    if args.revert:
        if not backup.is_file():
            print(f"!! no pristine backup for version {version} in {SHARE}", file=sys.stderr)
            for b in sorted(SHARE.glob("GameAssembly.so*.orig")):
                print(f"   available: {b.name}", file=sys.stderr)
            return 1
        running = game_running(game_dir)
        if running and not args.force:
            print("!! the game is running - close it first:", *running, sep="\n   ", file=sys.stderr)
            return 1
        so_path.write_bytes(backup.read_bytes())
        print(f"restored : {backup.name} -> GameAssembly.so")
        prefs = prefs_store(game_dir)
        if prefs and prefs.is_file():
            if prefs_backup.is_file():
                prefs.write_bytes(prefs_backup.read_bytes())
                print(f"restored : {prefs_backup.name} -> {prefs}")
            elif prefs_key_value(prefs, "CKey"):
                set_prefs_key(prefs, "CKey", "")
                print(f"cleared  : cheat code marker removed from {prefs.name}")
        print("state    : cheats disabled (pristine).")
        return 0

    # Analysis always runs on pristine bytes: once the library is patched the
    # original shapes are gone, so prefer the kept backup for discovery.
    src_path = backup if backup.is_file() else so_path
    elf = Elf(src_path)
    live = Elf(so_path)
    gate = analyse(elf)
    if gate is None:
        print(
            "\n!! could not locate Options.GetCheatTier structurally.\n"
            "   This build's cheat system no longer matches the known shape, or the library\n"
            "   is damaged/half-patched. Nothing was written.\n"
            "   Recovery: restore from backup (mdrg-cheats --revert) or verify the game install,\n"
            "   then dump it with Il2CppDumper and patch Options.GetCheatTier() by name.",
            file=sys.stderr,
        )
        return 1
    state = patch_state(live, gate)
    gate.update(state)

    off = elf.v2o(gate["tier_fn"])
    print(f"gate     : GetCheatTier @ vaddr {gate['tier_fn']:#x} (file offset {off:#x})")
    if gate["source"] == "recovered":
        print(f"tier     : advanced={gate['advanced']} (recovered from callers: {gate['compared']})")
    else:
        print(f"tier     : caller compares {gate['compared']} -> advanced={gate['advanced']} debug={gate['debug_const']} (source: {gate['source']})")
        print(f"wrappers : DebugEnabled@{gate['debug_site']:#x}({gate['debug_len']})  AnyCheatsEnabled@{gate['any_site']:#x}({gate['any_len']})")
    cg = gate.get("code_gate")
    if cg:
        print(f"keygate  : checker @{cg['validator']:#x} (stub: non-empty key = advanced); "
              f"enter-code path {cg['call_sites'][0]:#x} with {len(cg['guards'])} reject branches removed")
    elif gate["source"] != "recovered":
        print("keygate  : !! not found - falling back to pinning the tier")

    if gate["patched"]:
        print("\nlibrary  : ALREADY PATCHED (key gate + wrappers).")
    else:
        plan = apply_patch(elf, gate)
        if state.get("stale_pin"):
            print("\ntier pin : removing the old GetCheatTier pin (it hid the key input)")
        print("\npatches:")
        for line in plan:
            print("  - " + line)

    stored_code = prefs_key_value(prefs, "CKey") if (prefs and prefs.is_file()) else None
    if prefs is None:
        print("key      : !! could not derive the game's PlayerPrefs path (app.info missing)")
    elif stored_code:
        print(f"key      : CKey = {stored_code!r} -> the game boots with cheats already on "
              f"(press 'disable cheats' in-game, or pass --clear-key, to type your own)")
    else:
        print("key      : CKey empty -> the cheats popup will offer the key field")

    if args.status or args.dry_run:
        pending = []
        if not gate["patched"]:
            pending.append("library")
        if args.clear_key and stored_code:
            pending.append("clear stored key")
        print(f"\n({'status' if args.status else 'dry run'}) nothing written; pending: {', '.join(pending) or 'nothing'}.")
        return 0

    if gate["patched"] and not args.clear_key:
        print("\nstate    : ALREADY PATCHED - nothing to do.")
        return 0

    running = game_running(game_dir)
    if running and not args.force:
        print("\n!! the game is running - close it and re-run (or pass --force):", file=sys.stderr)
        for line in running:
            print("   " + line, file=sys.stderr)
        return 1

    ok = True
    if not gate["patched"]:
        if backup.is_file():
            print(f"\nbackup   : {backup.name} (already present for this version, kept)")
        else:
            backup.write_bytes(live.data)
            print(f"\nbackup   : {backup}")
        so_path.write_bytes(elf.render())

        # verify every patch site in the freshly written library
        check = Elf(so_path)
        wrappers_ok = check.at(gate["debug_site"], gate["debug_len"]) == patch_true(gate["debug_len"])
        if cg:
            key_ok = (
                check.at(cg["validator"], len(KEY_STUB)) == KEY_STUB
                and all(check.at(site, 6) == NOP6 for site in cg["guards"])
                and check.at(gate["tier_fn"], 6) != patch_mov_eax(gate["advanced"])
            )
            ok = wrappers_ok and key_ok
            print(f"written  : GameAssembly.so ({'verified' if ok else 'VERIFY FAILED'})"
                  f"  keygate={'ok' if key_ok else 'BAD'} wrappers={'ok' if wrappers_ok else 'BAD'}"
                  f" tier-pin={'absent' if check.at(gate['tier_fn'], 6) != patch_mov_eax(gate['advanced']) else 'STILL THERE'}")
        else:
            ok = wrappers_ok and check.at(gate["tier_fn"], 6) == patch_mov_eax(gate["advanced"])
            print(f"written  : GameAssembly.so ({'verified' if ok else 'VERIFY FAILED'})")
        print(f"sha256   : {sha256(so_path.read_bytes()).hexdigest()}")
        snip = disasm(so_path, cg["validator"] if cg else gate["tier_fn"], 12)
        if snip:
            print("after    :")
            print(snip)

    if args.clear_key and stored_code and prefs is not None:
        if not prefs_backup.is_file() and prefs.is_file():
            prefs_backup.write_bytes(prefs.read_bytes())
            print(f"backup   : {prefs_backup}")
        set_prefs_key(prefs, "CKey", "")
        print(f"cleared  : stored key removed -> the cheats popup will offer the key field")

    print("\nunlocked : money, church reset, cum cheats, add any item, colour/quality changes, fish weight, + debug features.")
    print("in-game  : cheats popup -> type any key of 10+ chars starting with A~ (e.g. " + KEY_HINT + ")")
    print("           it is accepted, stored, cheats turn on; 'disable cheats' turns them off again.")
    print("undo     : mdrg-cheats --revert")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
